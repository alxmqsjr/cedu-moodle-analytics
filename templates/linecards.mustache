{{!
    @template local_ceduanalytics/linecards

    Course lines with their editions (one card per line), on the Editions page.

    Example context (json):
    {"lines": [{"name": "Linha", "kind": "Trilha", "kindclass": "track", "editions": []}], "haslines": true}
}}
<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} cfg_lines_title, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} cfg_lines_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#haslines}}
        <div class="cea-lines">
            {{#lines}}
                <div class="cea-line cea-line-{{kindclass}}">
                    <div class="cea-line-head">
                        <h3>{{name}}</h3>
                        <span class="cea-badge cea-kind-{{kindclass}}">{{kind}}</span>
                    </div>
                    <ol class="cea-editions">
                        {{#editions}}
                            <li>
                                <a href="{{url}}" title="{{name}}">
                                    <span class="cea-edition-label">{{edition}}</span>
                                    <span class="cea-edition-meta">
                                        {{#str}} cfg_students_short, local_ceduanalytics, {{students}} {{/str}} ·
                                        {{#str}} cfg_certified_short, local_ceduanalytics, {{certified}} {{/str}}
                                    </span>
                                    {{#startdate}}<span class="cea-edition-date">{{startdate}}</span>{{/startdate}}
                                    {{^visible}}<span class="cea-edition-hidden">{{#str}} cfg_hidden, local_ceduanalytics {{/str}}</span>{{/visible}}
                                </a>
                            </li>
                        {{/editions}}
                    </ol>
                </div>
            {{/lines}}
        </div>
    {{/haslines}}
    {{^haslines}}
        <p class="cea-tableempty">{{#str}} cfg_lines_empty, local_ceduanalytics {{/str}}</p>
    {{/haslines}}
</section>
