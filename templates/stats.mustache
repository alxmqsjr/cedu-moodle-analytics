{{!
    @template local_ceduanalytics/stats

    Row of stat tiles.

    Example context (json):
    {"stats": [{"value": "21", "label": "Cursos", "type": "track", "warn": false}]}
}}
<div class="cea-stats">
    {{#stats}}
        <div class="cea-stat{{#type}} cea-stat-{{type}}{{/type}}{{#warn}} cea-stat-warn{{/warn}}">
            <span class="cea-stat-value">{{value}}</span>
            <span class="cea-stat-label">{{label}}</span>
        </div>
    {{/stats}}
</div>
