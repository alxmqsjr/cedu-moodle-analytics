{{!
    @template local_ceduanalytics/pathway

    Pathway and dropout page.

    Example context (json):
    {"funnel": {"hasdata": false}, "insight": "", "courses": {"hasrows": false, "id": "courses"},
     "stops": {"hasrows": false, "id": "stops"} }
}}
<p class="cea-compare"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}} path_intro, local_ceduanalytics {{/str}}</p>
{{#insight}}
    <div class="cea-alert cea-alert-info">
        <i class="fa-solid fa-lightbulb" aria-hidden="true"></i>
        <div><p>{{insight}}</p></div>
    </div>
{{/insight}}

<div class="cea-grid-2">
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} funnel_title, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} funnel_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#funnel}}{{> local_ceduanalytics/funnel }}{{/funnel}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} path_stops, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} path_stops_help, local_ceduanalytics {{/str}}</p>
        </header>
        <div class="cea-scroll">{{#stops}}{{> local_ceduanalytics/table }}{{/stops}}</div>
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} path_bycourse, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} path_bycourse_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#courses}}{{> local_ceduanalytics/table }}{{/courses}}
</section>
