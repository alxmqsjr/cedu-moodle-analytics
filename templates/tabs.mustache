{{!
    @template local_ceduanalytics/tabs

    Page tabs (links).

    Example context (json):
    {"tabs": [{"label": "Cursos", "url": "#", "active": true}, {"label": "Dados", "url": "#", "active": false}]}
}}
<nav class="cea-tabs">
    {{#tabs}}
        <a class="cea-tab{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>{{label}}</a>
    {{/tabs}}
</nav>
