{{!
    @template local_ceduanalytics/assessments_questions

    "Questions with most errors" block of the assessments page, placed right above Moodle's own question statistics.

    Example context (json):
    {"questions": {"hasrows": false, "id": "questions"}, "minattempts": 10}
}}
<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} as_questions, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} as_questions_help, local_ceduanalytics, {{minattempts}} {{/str}}</p>
    </header>
    <div class="cea-scroll">{{#questions}}{{> local_ceduanalytics/table }}{{/questions}}</div>
</section>
