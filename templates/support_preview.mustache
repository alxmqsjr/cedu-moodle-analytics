{{!
    @template local_ceduanalytics/support_preview

    Confirmation of a message or note before it is sent.

    Example context (json):
    {"title": "3 mensagens", "isnote": false, "notestate": "", "samples": [{"name": "Ana", "text": "Olá"}],
     "recipients": "Ana (Curso)", "hidden": [{"name": "mode", "value": "confirm"}], "formaction": "#", "cancelurl": "#"}
}}
<section class="cea-card cea-preview" aria-labelledby="cea-preview-title">
    <header class="cea-card-head">
        <h2 id="cea-preview-title"><i class="fa-regular fa-eye" aria-hidden="true"></i> {{title}}</h2>
        <p>{{#isnote}}{{notestate}}{{/isnote}}{{^isnote}}{{#str}} sup_preview_message_help, local_ceduanalytics {{/str}}{{/isnote}}</p>
    </header>
    <div class="cea-preview-samples">
        {{#samples}}
            <figure class="cea-preview-sample">
                <figcaption>{{name}}</figcaption>
                <div class="cea-preview-text">{{text}}</div>
            </figure>
        {{/samples}}
    </div>
    <details class="cea-preview-recipients">
        <summary>{{#str}} sup_recipients, local_ceduanalytics {{/str}}</summary>
        <p>{{recipients}}</p>
    </details>
    <form method="post" action="{{formaction}}" class="cea-preview-actions">
        {{#hidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hidden}}
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
            {{#isnote}}{{#str}} sup_confirm_note, local_ceduanalytics {{/str}}{{/isnote}}{{^isnote}}{{#str}} sup_confirm_message, local_ceduanalytics {{/str}}{{/isnote}}
        </button>
        <a class="btn btn-secondary" href="{{cancelurl}}">{{#str}} cancel, core {{/str}}</a>
    </form>
</section>
