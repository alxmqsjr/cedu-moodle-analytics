{{!
    @template local_ceduanalytics/editions

    Editions page.

    Example context (json):
    {"hasline": false, "linename": "", "editions": {"hasrows": false}, "chart": "", "haschart": false, "clearurl": "#",
     "chooseline": "", "lines": {"hasrows": false, "id": "lines"}, "tracks": {"hasrows": false, "id": "tracks"} }
}}
<p class="cea-compare"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}} ed_intro, local_ceduanalytics {{/str}}</p>

{{#hasline}}
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{linename}}</h2>
            <p>{{#str}} ed_line_help, local_ceduanalytics {{/str}} <a href="{{clearurl}}">{{#str}} ed_alllines, local_ceduanalytics {{/str}}</a></p>
        </header>
        {{#haschart}}<div class="cea-chart">{{{chart}}}</div>{{/haschart}}
        {{#editions}}{{> local_ceduanalytics/table }}{{/editions}}
    </section>
{{/hasline}}
{{^hasline}}{{{chooseline}}}{{/hasline}}

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} ed_lines, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} ed_lines_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#lines}}{{> local_ceduanalytics/table }}{{/lines}}
</section>

{{#linecards}}{{> local_ceduanalytics/linecards }}{{/linecards}}

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} ed_tracks, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} ed_tracks_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#tracks}}{{> local_ceduanalytics/table }}{{/tracks}}
</section>
