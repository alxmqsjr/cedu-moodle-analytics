{{!
    @template local_ceduanalytics/menu_item

    One item of the side menu.

    Example context (json):
    {"id": "home", "label": "Início", "icon": "fa-house", "url": "#", "active": true, "soon": true, "phase": 2}
}}
<li>
    <a class="cea-navlink{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>
        <i class="fa-solid {{icon}} cea-navicon" aria-hidden="true"></i>
        <span class="cea-navlabel">{{label}}</span>
        {{#soon}}<span class="cea-soon" title="{{#str}} soon_title, local_ceduanalytics, {{phase}} {{/str}}">F{{phase}}</span>{{/soon}}
    </a>
</li>
