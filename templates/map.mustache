{{!
    @template local_ceduanalytics/map

    Map of Brazil (choropleth over the IBGE mesh), UF sources and tables by state, region and municipality.

    Example context (json):
    {"kpis": [], "metrics": [{"id": "students", "label": "Estudantes", "active": true, "url": "#"}],
     "shapes": [{"uf": "SP", "d": "M0,0L10,0L10,10Z", "level": 5, "title": "São Paulo", "url": "#"}],
     "labels": [{"uf": "SP", "value": "10", "x": 5, "y": 5, "iscallout": false, "x1": 5, "y1": 5, "x2": 5, "y2": 5, "dark": true, "vy": 18}],
     "width": 476, "height": 544, "legend": [{"level": 0}], "maxtext": "10", "metriclabel": "Estudantes", "ratenote": false,
     "sources": {"hasbars": false}, "unknownnote": "", "states": {"hasrows": false, "id": "states"},
     "regions": {"hasrows": false, "id": "regions"}, "cities": {"hasrows": false, "id": "cities"} }
}}
{{> local_ceduanalytics/kpis }}

<div class="cea-grid-main">
    <section class="cea-card">
        <header class="cea-card-head cea-card-head-row">
            <div>
                <h2>{{#str}} map_title, local_ceduanalytics {{/str}}</h2>
                <p>{{#str}} map_title_help, local_ceduanalytics {{/str}}</p>
            </div>
            <div class="cea-segmented" role="group" aria-label="{{#str}} map_metric, local_ceduanalytics {{/str}}">
                {{#metrics}}<a href="{{url}}" class="{{#active}}is-active{{/active}}" {{#active}}aria-current="true"{{/active}}>{{label}}</a>{{/metrics}}
            </div>
        </header>
        <div class="cea-map">
            <svg viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="cea-map-title" class="cea-map-svg">
                <title id="cea-map-title">{{#str}} map_svg_title, local_ceduanalytics, {{metriclabel}} {{/str}}</title>
                {{#shapes}}
                    <a href="{{url}}" class="cea-state cea-tile-l{{level}}" aria-label="{{title}}">
                        <title>{{title}}</title>
                        <path d="{{d}}"></path>
                    </a>
                {{/shapes}}
                <g class="cea-map-labels" aria-hidden="true">
                    {{#labels}}
                        {{#iscallout}}<line x1="{{x1}}" y1="{{y1}}" x2="{{x2}}" y2="{{y2}}" class="cea-callout"></line>{{/iscallout}}
                        <text x="{{x}}" y="{{y}}" text-anchor="{{#iscallout}}start{{/iscallout}}{{^iscallout}}middle{{/iscallout}}" class="cea-map-uf{{#dark}} is-dark{{/dark}}">{{uf}}{{#iscallout}} <tspan class="cea-map-value">{{value}}</tspan>{{/iscallout}}</text>
                        {{^iscallout}}<text x="{{x}}" y="{{vy}}" text-anchor="middle" class="cea-map-value{{#dark}} is-dark{{/dark}}">{{value}}</text>{{/iscallout}}
                    {{/labels}}
                </g>
            </svg>
            <div class="cea-map-legend" aria-hidden="true">
                <span>0</span>
                {{#legend}}<span class="cea-legend-swatch cea-tile-l{{level}}"></span>{{/legend}}
                <span>{{maxtext}}</span>
            </div>
            <p class="cea-help">{{#str}} map_tile_help, local_ceduanalytics {{/str}}{{#ratenote}} {{#str}} map_rate_help, local_ceduanalytics {{/str}}{{/ratenote}}</p>
        </div>
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} map_sources, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} map_sources_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#sources}}{{> local_ceduanalytics/bars }}{{/sources}}
        <p class="cea-help"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{unknownnote}}</p>
        <h3 class="cea-subhead">{{#str}} map_byregion, local_ceduanalytics {{/str}}</h3>
        {{#regions}}{{> local_ceduanalytics/table }}{{/regions}}
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} map_bystate, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} map_bystate_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#states}}{{> local_ceduanalytics/table }}{{/states}}
</section>

<section class="cea-card">
    <header class="cea-card-head cea-card-head-tools">
        <div class="cea-card-head-text">
            <h2>{{#str}} map_bycity, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} map_bycity_help, local_ceduanalytics {{/str}}</p>
        </div>
        <label class="cea-tablesearch">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} table_filter, local_ceduanalytics {{/str}}</span>
            <input type="search" class="form-control" data-region="cea-tablefilter" data-target="cea-table-cities"
                   placeholder="{{#str}} table_filter, local_ceduanalytics {{/str}}">
        </label>
    </header>
    <div class="cea-scroll">{{#cities}}{{> local_ceduanalytics/table }}{{/cities}}</div>
</section>
