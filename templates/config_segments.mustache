{{!
    @template local_ceduanalytics/config_segments

    Configuration: audience segments from the job title.

    Example context (json):
    {"distribution": {"hasrows": false}, "unclassified": {"hasrows": false}, "rules": [], "newoptions": [],
     "formaction": "#", "sesskey": "x", "lastrun": "ontem"}
}}
<div class="cea-alert cea-alert-info">
    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
    <div><p>{{#str}} cfg_segments_intro, local_ceduanalytics, {{lastrun}} {{/str}}</p></div>
</div>

<div class="cea-grid-2">
    <section class="cea-card">
        <header class="cea-card-head"><h2>{{#str}} cfg_segments_distribution, local_ceduanalytics {{/str}}</h2></header>
        {{#distribution}}{{> local_ceduanalytics/table }}{{/distribution}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} cfg_segments_unclassified, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} cfg_segments_unclassified_help, local_ceduanalytics {{/str}}</p>
        </header>
        <div class="cea-scroll">{{#unclassified}}{{> local_ceduanalytics/table }}{{/unclassified}}</div>
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} cfg_rules_title, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} cfg_rules_help, local_ceduanalytics {{/str}}</p>
    </header>
    <form method="post" action="{{formaction}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="saverules">
        <div class="cea-tablewrap">
            <table class="cea-table cea-table-form">
                <thead><tr>
                    <th scope="col" class="cea-num">{{#str}} cfg_rule_order, local_ceduanalytics {{/str}}</th>
                    <th scope="col">{{#str}} cfg_rule_pattern, local_ceduanalytics {{/str}}</th>
                    <th scope="col">{{#str}} cfg_rule_segment, local_ceduanalytics {{/str}}</th>
                    <th scope="col">{{#str}} cfg_rule_delete, local_ceduanalytics {{/str}}</th>
                </tr></thead>
                <tbody>
                    {{#rules}}
                        <tr>
                            <td class="cea-num"><input type="number" class="form-control cea-input-xs" name="ruleorder[{{id}}]" value="{{order}}"
                                       aria-label="{{#str}} cfg_rule_order, local_ceduanalytics {{/str}}"></td>
                            <td><input type="text" class="form-control" name="rulepattern[{{id}}]" value="{{pattern}}"
                                       aria-label="{{#str}} cfg_rule_pattern, local_ceduanalytics {{/str}}"></td>
                            <td><select class="custom-select" name="rulesegment[{{id}}]" aria-label="{{#str}} cfg_rule_segment, local_ceduanalytics {{/str}}">
                                {{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}
                            </select></td>
                            <td><input type="checkbox" name="ruledelete[{{id}}]" value="1"
                                       aria-label="{{#str}} cfg_rule_delete, local_ceduanalytics {{/str}}: {{pattern}}"></td>
                        </tr>
                    {{/rules}}
                    <tr class="cea-newrow">
                        <td class="cea-num"><input type="number" class="form-control cea-input-xs" name="neworder" value="1000"
                                   aria-label="{{#str}} cfg_rule_order, local_ceduanalytics {{/str}}"></td>
                        <td><input type="text" class="form-control" name="newpattern" placeholder="{{#str}} cfg_rule_new, local_ceduanalytics {{/str}}"
                                   aria-label="{{#str}} cfg_rule_new, local_ceduanalytics {{/str}}"></td>
                        <td><select class="custom-select" name="newsegment" aria-label="{{#str}} cfg_rule_segment, local_ceduanalytics {{/str}}">
                            {{#newoptions}}<option value="{{value}}">{{label}}</option>{{/newoptions}}
                        </select></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="cea-formactions">
            <button type="submit" class="btn btn-primary">{{#str}} cfg_rules_save, local_ceduanalytics {{/str}}</button>
        </div>
    </form>
</section>
