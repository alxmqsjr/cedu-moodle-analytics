{{!
    @template local_ceduanalytics/assessments

    Assessments and questions page.

    Example context (json):
    {"kpis": [], "thresholdnote": "", "chart": "", "haschart": false, "chartempty": "", "minattempts": 10,
     "quizzes": {"hasrows": false, "id": "quizzes"},
     "assigns": {"hasrows": false, "id": "assigns"} }
}}
<p class="cea-compare"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{thresholdnote}}</p>
{{> local_ceduanalytics/kpis }}

<div class="cea-grid-2">
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} as_distribution, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} as_distribution_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#haschart}}<div class="cea-chart">{{{chart}}}</div>{{/haschart}}
        {{^haschart}}{{{chartempty}}}{{/haschart}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} as_assigns, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} as_assigns_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#assigns}}{{> local_ceduanalytics/table }}{{/assigns}}
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head cea-card-head-tools">
        <div class="cea-card-head-text">
            <h2>{{#str}} as_quizzes, local_ceduanalytics {{/str}}</h2>
        </div>
        <label class="cea-tablesearch">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} table_filter, local_ceduanalytics {{/str}}</span>
            <input type="search" class="form-control" data-region="cea-tablefilter" data-target="cea-table-quizzes"
                   placeholder="{{#str}} table_filter, local_ceduanalytics {{/str}}">
        </label>
    </header>
    {{#quizzes}}{{> local_ceduanalytics/table }}{{/quizzes}}
</section>
