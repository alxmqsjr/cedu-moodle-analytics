{{!
    @template local_ceduanalytics/extra

    An additional data block of a page: title, explanation and table.

    Example context (json):
    {"id": "scorm", "title": "SCORM", "help": "Pacotes SCORM",
     "table": {"hasrows": false, "id": "scorm", "emptytext": "Sem dados"}
    }
}}
<section class="cea-card" id="cea-block-{{id}}">
    <header class="cea-card-head">
        <h2>{{title}}</h2>
        <p>{{help}}</p>
    </header>
    <div class="cea-scroll">{{#table}}{{> local_ceduanalytics/table }}{{/table}}</div>
</section>
