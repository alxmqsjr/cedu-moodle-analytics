{{!
    @template local_ceduanalytics/team

    Teaching team: KPIs, one card per teacher, unanswered messages and pending grading.

    Example context (json):
    {"kpis": [], "hascards": true, "nocards": "", "effectdays": 7,
     "cards": [{"name": "Ana", "dualmark": "", "url": "#", "roles": "Professor", "suspended": false, "courses": "2", "students": "40",
                "messages": "10", "notes": "3", "contacted": "8", "replytime": "2 h", "unanswered": "1", "hasunanswered": true,
                "grading": "0", "hasgrading": false, "lastaccess": "ontem", "lastcourse": "ontem", "stale": false, "effect": "50%"}],
     "unanswered": {"hasrows": false, "id": "unanswered"}, "grading": {"hasrows": false, "id": "grading"} }
}}
{{> local_ceduanalytics/kpis }}

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} team_cards, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} team_cards_help, local_ceduanalytics, {{effectdays}} {{/str}}</p>
    </header>
    {{#hascards}}
    <div class="cea-teamcards">
        {{#cards}}
            <article class="cea-teamcard{{#stale}} is-stale{{/stale}}">
                <header>
                    <h3><a href="{{url}}">{{name}}</a>{{{dualmark}}}</h3>
                    <p class="cea-muted">{{roles}} {{#suspended}}<span class="cea-badge cea-badge-danger">{{#str}} suspended, core {{/str}}</span>{{/suspended}}</p>
                </header>
                <dl class="cea-teamcard-stats">
                    <div><dt>{{#str}} col_courses, local_ceduanalytics {{/str}}</dt><dd>{{courses}}</dd></div>
                    <div><dt>{{#str}} col_activestudents, local_ceduanalytics {{/str}}</dt><dd>{{students}}</dd></div>
                    <div><dt>{{#str}} col_messages, local_ceduanalytics {{/str}}</dt><dd>{{messages}}</dd></div>
                    <div><dt>{{#str}} col_notes, local_ceduanalytics {{/str}}</dt><dd>{{notes}}</dd></div>
                    <div><dt>{{#str}} col_contacted, local_ceduanalytics {{/str}}</dt><dd>{{contacted}}</dd></div>
                    <div><dt>{{#str}} col_replytime, local_ceduanalytics {{/str}}</dt><dd>{{replytime}}</dd></div>
                    <div><dt>{{#str}} col_returned, local_ceduanalytics {{/str}}</dt><dd>{{effect}}</dd></div>
                    <div class="{{#hasunanswered}}is-alert{{/hasunanswered}}"><dt>{{#str}} col_unanswered, local_ceduanalytics {{/str}}</dt><dd>{{unanswered}}</dd></div>
                    <div class="{{#hasgrading}}is-alert{{/hasgrading}}"><dt>{{#str}} col_grading, local_ceduanalytics {{/str}}</dt><dd>{{grading}}</dd></div>
                </dl>
                <footer class="cea-muted">
                    <i class="fa-regular fa-clock" aria-hidden="true"></i>
                    {{#str}} team_lastcourse, local_ceduanalytics, {{lastcourse}} {{/str}}
                    {{#stale}}<span class="cea-badge cea-level-medium">{{#str}} team_stale, local_ceduanalytics {{/str}}</span>{{/stale}}
                </footer>
            </article>
        {{/cards}}
    </div>
    {{/hascards}}
    {{^hascards}}{{{nocards}}}{{/hascards}}

</section>

<section class="cea-card">
    <header class="cea-card-head cea-card-head-tools">
        <div class="cea-card-head-text">
            <h2>{{#str}} team_unanswered, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} team_unanswered_help, local_ceduanalytics {{/str}}</p>
        </div>
        <label class="cea-tablesearch">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} table_filter, local_ceduanalytics {{/str}}</span>
            <input type="search" class="form-control" data-region="cea-tablefilter" data-target="cea-table-unanswered"
                   placeholder="{{#str}} table_filter, local_ceduanalytics {{/str}}">
        </label>
    </header>
    <div class="cea-scroll">{{#unanswered}}{{> local_ceduanalytics/table }}{{/unanswered}}</div>
</section>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} team_grading, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} team_grading_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#grading}}{{> local_ceduanalytics/table }}{{/grading}}
</section>
