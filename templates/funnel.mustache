{{!
    @template local_ceduanalytics/funnel

    Funnel from enrolment to certificate (an ordered list readable without the bars).

    Example context (json):
    {"hasdata": true, "stages": [{"label": "Matriculados", "value": "10", "pct": "100%", "width": 100, "loss": "", "url": ""}] }
}}
{{#hasdata}}
<ol class="cea-funnel">
    {{#stages}}
        <li class="cea-funnel-stage">
            <span class="cea-funnel-label">{{#url}}<a href="{{url}}">{{label}}</a>{{/url}}{{^url}}{{label}}{{/url}}</span>
            <span class="cea-funnel-track" aria-hidden="true"><span class="cea-funnel-fill" style="width: {{width}}%"></span></span>
            <span class="cea-funnel-value">{{value}} <small>{{pct}}</small></span>
            {{#loss}}<span class="cea-funnel-loss">{{loss}}</span>{{/loss}}
        </li>
    {{/stages}}
</ol>
{{/hasdata}}
{{^hasdata}}
    <p class="cea-tableempty"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}} empty_students, local_ceduanalytics {{/str}}</p>
{{/hasdata}}
