{{!
    @template local_ceduanalytics/empty_state

    Explains why a block or page has no data, and what to do.

    Example context (json):
    {"icon": "fa-chart-line", "title": "Sem dados", "text": "Explicação.", "note": "", "large": false}
}}
<div class="cea-empty{{#large}} cea-empty-large{{/large}}" role="status">
    <div class="cea-empty-icon"><i class="fa-solid {{icon}}" aria-hidden="true"></i></div>
    <h2 class="cea-empty-title">{{title}}</h2>
    <p class="cea-empty-text">{{text}}</p>
    {{#note}}<p class="cea-empty-note">{{note}}</p>{{/note}}
</div>
