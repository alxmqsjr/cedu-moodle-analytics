{{!
    @template local_ceduanalytics/course

    Course panel.

    Example context (json):
    {"fullname": "Curso", "shortname": "C", "category": "Cat", "typebadge": "", "statusbadge": "", "healthbadge": "",
     "reasons": ["ok"], "line": "Linha", "start": "", "end": "", "visible": true, "nocriteria": true, "links": [], "kpis": [],
     "funnel": {"hasdata": false}, "sitbars": {"hasbars": false}, "chart": "", "haschart": false, "chartempty": "",
     "activities": {"hasrows": false, "id": "activities"}, "teachers": {"hasrows": false, "id": "teachers"} }
}}
<section class="cea-card cea-coursehead">
    <div class="cea-coursehead-main">
        <div>
            <p class="cea-muted cea-coursehead-meta">{{category}} · {{shortname}} · {{line}}</p>
            <div class="cea-badges">{{{typebadge}}} {{{statusbadge}}} {{{healthbadge}}}
                {{^visible}}<span class="cea-badge cea-badge-soft">{{#str}} visible_no, local_ceduanalytics {{/str}}</span>{{/visible}}</div>
            <ul class="cea-reasons cea-reasons-inline">{{#reasons}}<li>{{.}}</li>{{/reasons}}</ul>
            <p class="cea-muted"><i class="fa-regular fa-calendar" aria-hidden="true"></i> {{start}} → {{end}}</p>
        </div>
        <div class="cea-profile-links">
            {{#links}}<a class="btn cea-btn-ghost btn-sm" href="{{url}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{label}}</a>{{/links}}
        </div>
    </div>
    {{#nocriteria}}
        <p class="cea-help cea-warn-text"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{#str}} course_nocriteria, local_ceduanalytics {{/str}}</p>
    {{/nocriteria}}
</section>

{{> local_ceduanalytics/kpis }}

<div class="cea-grid-2">
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} funnel_title, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} funnel_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#funnel}}{{> local_ceduanalytics/funnel }}{{/funnel}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} course_situations, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} course_situations_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#sitbars}}{{> local_ceduanalytics/bars }}{{/sitbars}}
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} course_timeline, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} course_timeline_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#haschart}}<div class="cea-chart">{{{chart}}}</div>{{/haschart}}
    {{^haschart}}{{{chartempty}}}{{/haschart}}
</section>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} course_activities, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} course_activities_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#activities}}{{> local_ceduanalytics/table }}{{/activities}}
</section>

<section class="cea-card">
    <header class="cea-card-head"><h2>{{#str}} course_teachers, local_ceduanalytics {{/str}}</h2></header>
    {{#teachers}}{{> local_ceduanalytics/table }}{{/teachers}}
</section>
