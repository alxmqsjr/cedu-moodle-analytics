{{!
    @template local_ceduanalytics/reports

    Report centre: executive summary and one spreadsheet per page (one sheet per list).

    Example context (json):
    {"bulletinurl": "#", "periodlabel": "Últimos 12 meses", "count": 2, "spreadsheets": 1, "canexport": true,
     "pages": [{"group": "Estudantes", "page": "Visão geral", "pageid": "students", "icon": "fa-users", "url": "#",
        "lists": [{"label": "Por estudante"}, {"label": "Por matrícula"}], "count": 2, "downloadlabel": "Baixar", "xlsx": "#"}]}
}}
<section class="cea-card cea-bulletin-cta">
    <div>
        <h2><i class="fa-solid fa-newspaper" aria-hidden="true"></i> {{#str}} rep_bulletin, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} rep_bulletin_help, local_ceduanalytics, {{periodlabel}} {{/str}}</p>
    </div>
    <a class="btn btn-primary" href="{{bulletinurl}}"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> {{#str}} rep_bulletin_open, local_ceduanalytics {{/str}}</a>
</section>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} rep_catalogue, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} rep_catalogue_help, local_ceduanalytics, { "lists": {{count}}, "files": {{spreadsheets}} } {{/str}}</p>
    </header>
    {{^canexport}}<p class="cea-help"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{#str}} rep_noexport, local_ceduanalytics {{/str}}</p>{{/canexport}}
    <div class="cea-catalogue">
        {{#pages}}
            <article class="cea-catalogue-page">
                <p class="cea-catalogue-group">{{group}}</p>
                <h3><a href="{{url}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i> {{page}}</a></h3>
                <ul>
                    {{#lists}}<li><i class="fa-regular fa-file-lines" aria-hidden="true"></i> {{label}}</li>{{/lists}}
                </ul>
                {{#canexport}}
                    <a class="btn btn-sm cea-btn-download" href="{{xlsx}}"><i class="fa-solid fa-file-excel" aria-hidden="true"></i> {{downloadlabel}}</a>
                {{/canexport}}
            </article>
        {{/pages}}
    </div>
</section>
