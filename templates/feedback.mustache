{{!
    @template local_ceduanalytics/feedback

    Feedback: instruments, aggregated answers per question, breakdown by the split question, instances.

    Example context (json):
    {"kpis": [], "instruments": [{"label": "Pesquisa (10)", "active": true, "url": "#"}], "hasmanyinstruments": false,
     "current": "Pesquisa", "anonymous": true, "splits": [], "hassplits": false, "hasanswers": true, "noanswers": "",
     "questions": [{"number": 1, "name": "Pergunta", "multiple": false, "answered": "10 respostas", "lowconf": false,
                    "bars": {"hasbars": false}, "haschoices": true, "texts": [], "hastexts": false, "textnote": "", "issplit": false}],
     "bysplit": {"hasrows": false, "id": "bysplit"}, "hasbysplit": false, "instances": {"hasrows": false, "id": "instances"} }
}}
{{> local_ceduanalytics/kpis }}

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{current}}</h2>
        <p>{{#anonymous}}<span class="cea-badge cea-badge-soft"><i class="fa-solid fa-user-secret" aria-hidden="true"></i> {{#str}} fb_anonymous, local_ceduanalytics {{/str}}</span> {{/anonymous}}{{#str}} fb_current_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#hasmanyinstruments}}
        <div class="cea-chiprow">
            <span class="cea-chiprow-label">{{#str}} fb_instrument, local_ceduanalytics {{/str}}</span>
            <nav class="cea-sitchips" aria-label="{{#str}} fb_instrument, local_ceduanalytics {{/str}}">
                {{#instruments}}<a class="cea-sitchip{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="true"{{/active}}><span class="cea-sitchip-label">{{label}}</span></a>{{/instruments}}
            </nav>
        </div>
    {{/hasmanyinstruments}}
    {{#hassplits}}
        <div class="cea-chiprow">
            <span class="cea-chiprow-label">{{#str}} col_region, local_ceduanalytics {{/str}}</span>
            <nav class="cea-sitchips" aria-label="{{#str}} col_region, local_ceduanalytics {{/str}}">
                {{#splits}}
                    <a class="cea-sitchip{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="true"{{/active}}>
                        <span class="cea-sitchip-label">{{label}}</span><span class="cea-sitchip-count">{{count}}</span>
                    </a>
                {{/splits}}
            </nav>
        </div>
        <p class="cea-help"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}} fb_split_help, local_ceduanalytics {{/str}}</p>
    {{/hassplits}}
</section>

{{#hasanswers}}
<div class="cea-fbgrid">
    {{#questions}}
        <section class="cea-card cea-fbq{{#issplit}} is-split{{/issplit}}">
            <header class="cea-card-head">
                <h3><span class="cea-fbq-number">{{number}}</span> {{name}}</h3>
                {{#issplit}}<p class="cea-fbq-split" title="{{#str}} fb_splitbadge_help, local_ceduanalytics {{/str}}"><span class="cea-badge cea-badge-split"><i class="fa-solid fa-map" aria-hidden="true"></i> {{#str}} fb_splitbadge, local_ceduanalytics {{/str}}</span></p>{{/issplit}}
                <p>{{answered}}{{#multiple}} · {{#str}} fb_multiple, local_ceduanalytics {{/str}}{{/multiple}}
                    {{#lowconf}}<span class="cea-lowconf" title="{{#str}} lowconf_help, local_ceduanalytics {{/str}}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{#str}} lowconf, local_ceduanalytics {{/str}}</span>{{/lowconf}}</p>
            </header>
            {{#haschoices}}{{#bars}}{{> local_ceduanalytics/bars }}{{/bars}}{{/haschoices}}
            {{^haschoices}}
                <p class="cea-help"><i class="fa-solid fa-user-secret" aria-hidden="true"></i> {{#str}} fb_textprivacy, local_ceduanalytics {{/str}}</p>
                {{#hastexts}}<ul class="cea-fbtexts">{{#texts}}<li>{{text}}</li>{{/texts}}</ul>{{/hastexts}}
                {{^hastexts}}<p class="cea-help">{{textnote}}</p>{{/hastexts}}
            {{/haschoices}}
        </section>
    {{/questions}}
</div>
{{/hasanswers}}
{{^hasanswers}}{{{noanswers}}}{{/hasanswers}}

{{#hasbysplit}}
<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} fb_bysplit, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} fb_bysplit_help, local_ceduanalytics {{/str}}</p>
    </header>
    <div class="cea-scroll">{{#bysplit}}{{> local_ceduanalytics/table }}{{/bysplit}}</div>
</section>
{{/hasbysplit}}

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} fb_instances, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} fb_instances_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#instances}}{{> local_ceduanalytics/table }}{{/instances}}
</section>
