{{!
    @template local_ceduanalytics/materials

    Materials and videos page.

    Example context (json):
    {"kpis": [], "typebars": {"hasbars": false}, "types": {"hasrows": false, "id": "types"},
     "items": {"hasrows": false, "id": "items"}, "videos": {"hasrows": false, "id": "videos"},
     "playback": {"hasrows": false, "id": "playback"}, "trackingon": true }
}}
<p class="cea-compare"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}} mat_intro, local_ceduanalytics {{/str}}</p>
{{> local_ceduanalytics/kpis }}

<div class="cea-grid-2">
    <section class="cea-card">
        <header class="cea-card-head"><h2>{{#str}} mat_types, local_ceduanalytics {{/str}}</h2></header>
        {{#types}}{{> local_ceduanalytics/table }}{{/types}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} mat_videos, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} mat_videos_help, local_ceduanalytics {{/str}}</p>
        </header>
        <div class="cea-scroll">{{#videos}}{{> local_ceduanalytics/table }}{{/videos}}</div>
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} mat_playback, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} mat_playback_help, local_ceduanalytics {{/str}}
            {{^trackingon}}<strong>{{#str}} mat_trackingoff, local_ceduanalytics {{/str}}</strong>{{/trackingon}}</p>
    </header>
    <div class="cea-scroll">{{#playback}}{{> local_ceduanalytics/table }}{{/playback}}</div>
</section>

<section class="cea-card">
    <header class="cea-card-head cea-card-head-tools">
        <div class="cea-card-head-text">
            <h2>{{#str}} mat_items, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} mat_items_help, local_ceduanalytics {{/str}}</p>
        </div>
        <label class="cea-tablesearch">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} table_filter, local_ceduanalytics {{/str}}</span>
            <input type="search" class="form-control" data-region="cea-tablefilter" data-target="cea-table-items"
                   placeholder="{{#str}} table_filter, local_ceduanalytics {{/str}}">
        </label>
    </header>
    <div class="cea-scroll cea-scroll-tall">{{#items}}{{> local_ceduanalytics/table }}{{/items}}</div>
</section>
