{{!
    @template local_ceduanalytics/arrivals

    First access page.

    Example context (json):
    {"kpis": [], "chart": "", "haschart": false, "chartempty": "", "courses": {"hasrows": false},
     "origin": {"hasrows": false}, "never": {"hasrows": false} }
}}
<p class="cea-compare"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}} arr_intro, local_ceduanalytics {{/str}}</p>
{{> local_ceduanalytics/kpis }}

<div class="cea-grid-main">
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} arr_chart, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} arr_chart_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#haschart}}<div class="cea-chart">{{{chart}}}</div>{{/haschart}}
        {{^haschart}}{{{chartempty}}}{{/haschart}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} arr_byorigin, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} arr_byorigin_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#origin}}{{> local_ceduanalytics/table }}{{/origin}}
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head"><h2>{{#str}} arr_bycourse, local_ceduanalytics {{/str}}</h2></header>
    {{#courses}}{{> local_ceduanalytics/table }}{{/courses}}
</section>

<section class="cea-card">
    <header class="cea-card-head cea-card-head-tools">
        <div class="cea-card-head-text">
            <h2>{{#str}} arr_never_list, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} arr_never_help, local_ceduanalytics {{/str}}</p>
        </div>
        <label class="cea-tablesearch">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} table_filter, local_ceduanalytics {{/str}}</span>
            <input type="search" class="form-control" data-region="cea-tablefilter" data-target="cea-table-never"
                   placeholder="{{#str}} table_filter, local_ceduanalytics {{/str}}">
        </label>
    </header>
    {{#never}}{{> local_ceduanalytics/table }}{{/never}}
</section>
