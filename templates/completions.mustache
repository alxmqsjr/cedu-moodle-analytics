{{!
    @template local_ceduanalytics/completions

    Certificates and completions page.

    Example context (json):
    {"nocriteria": true, "kpis": [], "chart": "", "haschart": false, "chartempty": "",
     "courses": {"hasrows": false, "id": "courses"}, "certificates": {"hasrows": false, "id": "certificates"},
     "nocert": {"hasrows": false, "id": "nocert"} }
}}
{{#nocriteria}}
    <div class="cea-alert cea-alert-warn" role="alert">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
            <strong>{{#str}} alert_nocriteria_title, local_ceduanalytics {{/str}}</strong>
            <p>{{#str}} alert_nocriteria_text, local_ceduanalytics {{/str}}</p>
        </div>
    </div>
{{/nocriteria}}
{{> local_ceduanalytics/kpis }}

<div class="cea-grid-main">
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} comp_chart, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} comp_chart_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#haschart}}<div class="cea-chart">{{{chart}}}</div>{{/haschart}}
        {{^haschart}}{{{chartempty}}}{{/haschart}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} comp_nocertlist, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} comp_nocertlist_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#nocert}}{{> local_ceduanalytics/table }}{{/nocert}}
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head"><h2>{{#str}} comp_bycourse, local_ceduanalytics {{/str}}</h2></header>
    {{#courses}}{{> local_ceduanalytics/table }}{{/courses}}
</section>

<section class="cea-card">
    <header class="cea-card-head cea-card-head-tools">
        <div class="cea-card-head-text">
            <h2>{{#str}} comp_certlist, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} comp_certlist_help, local_ceduanalytics {{/str}}</p>
        </div>
        <label class="cea-tablesearch">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} table_filter, local_ceduanalytics {{/str}}</span>
            <input type="search" class="form-control" data-region="cea-tablefilter" data-target="cea-table-certificates"
                   placeholder="{{#str}} table_filter, local_ceduanalytics {{/str}}">
        </label>
    </header>
    <div class="cea-scroll">{{#certificates}}{{> local_ceduanalytics/table }}{{/certificates}}</div>
</section>
