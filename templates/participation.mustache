{{!
    @template local_ceduanalytics/participation

    Participation page.

    Example context (json):
    {"kpis": [], "chart": "", "haschart": false, "chartempty": "", "unitlabel": "por semana",
     "heatmap": {"hasdata": false, "rows": [], "hours": []}, "heatnote": "", "device": {"hasbars": false}, "hasdevice": false, "devicetotal": "0", "deviceviews": "0", "devicewrites": "0",
     "courses": {"hasrows": false}, "students": {"hasrows": false} }
}}
<p class="cea-compare"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}} part_intro, local_ceduanalytics {{/str}}</p>
{{> local_ceduanalytics/kpis }}

<div class="cea-grid-main">
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} part_timeline, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} part_timeline_help, local_ceduanalytics, {{unitlabel}} {{/str}}</p>
        </header>
        {{#haschart}}<div class="cea-chart">{{{chart}}}</div>{{/haschart}}
        {{^haschart}}{{{chartempty}}}{{/haschart}}
    </section>
    <section class="cea-card">
        <header class="cea-card-head">
            <h2>{{#str}} part_device, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} part_device_help, local_ceduanalytics {{/str}}</p>
        </header>
        {{#hasdevice}}
            {{#device}}{{> local_ceduanalytics/bars }}{{/device}}
            <div class="cea-deviceinfo">
                <p class="cea-deviceinfo-total"><strong>{{devicetotal}}</strong> {{#str}} part_device_total, local_ceduanalytics {{/str}}</p>
                <dl>
                    <dt>{{#str}} part_device_what, local_ceduanalytics {{/str}}</dt>
                    <dd>{{#str}} part_device_what_text, local_ceduanalytics {{/str}}</dd>
                    <dt>{{#str}} part_device_kinds, local_ceduanalytics {{/str}}</dt>
                    <dd>{{#str}} part_device_views, local_ceduanalytics, {{deviceviews}} {{/str}}<br>
                        {{#str}} part_device_writes, local_ceduanalytics, {{devicewrites}} {{/str}}</dd>
                    <dt>{{#str}} part_device_how, local_ceduanalytics {{/str}}</dt>
                    <dd>{{#str}} part_device_how_text, local_ceduanalytics {{/str}}</dd>
                </dl>
            </div>
        {{/hasdevice}}
        {{^hasdevice}}<p class="cea-tableempty">{{#str}} empty_activity_text, local_ceduanalytics {{/str}}</p>{{/hasdevice}}
    </section>
</div>

<section class="cea-card">
    <header class="cea-card-head">
        <h2>{{#str}} part_heatmap, local_ceduanalytics {{/str}}</h2>
        <p>{{#str}} part_heatmap_help, local_ceduanalytics {{/str}}</p>
    </header>
    {{#heatnote}}<p class="cea-help"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{heatnote}}</p>{{/heatnote}}
    {{#heatmap}}{{> local_ceduanalytics/heatmap }}{{/heatmap}}
</section>

<section class="cea-card">
    <header class="cea-card-head"><h2>{{#str}} part_bycourse, local_ceduanalytics {{/str}}</h2></header>
    {{#courses}}{{> local_ceduanalytics/table }}{{/courses}}
</section>

<section class="cea-card">
    <header class="cea-card-head cea-card-head-tools">
        <div class="cea-card-head-text">
            <h2>{{#str}} part_bystudent, local_ceduanalytics {{/str}}</h2>
            <p>{{#str}} part_bystudent_help, local_ceduanalytics {{/str}}</p>
        </div>
        <label class="cea-tablesearch">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="sr-only">{{#str}} table_filter, local_ceduanalytics {{/str}}</span>
            <input type="search" class="form-control" data-region="cea-tablefilter" data-target="cea-table-students"
                   placeholder="{{#str}} table_filter, local_ceduanalytics {{/str}}">
        </label>
    </header>
    <div class="cea-scroll">{{#students}}{{> local_ceduanalytics/table }}{{/students}}</div>
</section>
