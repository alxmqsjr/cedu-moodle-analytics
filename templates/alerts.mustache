{{!
    @template local_ceduanalytics/alerts

    Platform alerts by category.

    Example context (json):
    {"kpis": [],
     "chips": [{"label": "Todos", "count": "1", "active": true, "url": "#", "key": "all"}],
     "groups": [{"name": "Segurança", "help": "", "hasitems": true, "items": [{"severity": "critical",
        "severitylabel": "Crítico", "icon": "fa-circle-exclamation", "title": "Bloqueio", "text": "Desligado",
        "fixurl": "#", "pageurl": "#"}]}] }
}}
{{> local_ceduanalytics/caution }}
    {{> local_ceduanalytics/kpis }}
    <nav class="cea-sitchips" aria-label="{{#str}} col_category, local_ceduanalytics {{/str}}">
        {{#chips}}
            <a class="cea-sitchip{{#active}} is-active{{/active}}" href="{{url}}" {{#active}}aria-current="true"{{/active}}>
                <span class="cea-sitchip-label">{{label}}</span><span class="cea-sitchip-count">{{count}}</span>
            </a>
        {{/chips}}
    </nav>
    {{#groups}}
        <section class="cea-card">
            <header class="cea-card-head">
                <h2>{{name}}</h2>
                <p>{{help}}</p>
            </header>
            {{#hasitems}}
            <ul class="cea-checks">
                {{#items}}
                    <li class="cea-check cea-check-{{severity}}">
                        <i class="fa-solid {{icon}}" aria-hidden="true"></i>
                        <div>
                            <strong>{{title}}</strong> <span class="cea-badge cea-check-badge">{{severitylabel}}</span>
                            <p>{{text}}</p>
                        </div>
                        <div class="cea-check-actions">
                            {{#fixurl}}<a class="btn cea-btn-ghost btn-sm" href="{{fixurl}}">{{#str}} al_fix, local_ceduanalytics {{/str}} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>{{/fixurl}}
                            {{#pageurl}}<a class="btn cea-btn-ghost btn-sm" href="{{pageurl}}">{{#str}} al_see, local_ceduanalytics {{/str}}</a>{{/pageurl}}
                        </div>
                    </li>
                {{/items}}
            </ul>
            {{/hasitems}}
            {{^hasitems}}<p class="cea-tableempty"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> {{#str}} al_none, local_ceduanalytics {{/str}}</p>{{/hasitems}}
        </section>
    {{/groups}}
